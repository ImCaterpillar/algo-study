# Copy this file to .env for local development.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local demo account. In production set CREATE_DEMO_USER=false.
CREATE_DEMO_USER=true
DEMO_USERNAME=admin
DEMO_EMAIL=admin@example.com
DEMO_PASSWORD=admin123

# Code execution is intended for local learning only.
CODE_EXECUTION_ENABLED=true
MAX_CODE_EXECUTION_TIMEOUT=10

# Optional. Defaults to sqlite:///backend/algo_study.db
# DATABASE_URL=sqlite:///./algo_study.db
