# AlgoStudy Docker Compose deployment config
APP_ENV=production
APP_PORT=8080

# Deploy script will auto-generate this if left as the placeholder below.
SECRET_KEY=change-me-before-deploy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Same-origin nginx proxy uses /api. For separate frontend/backend domains, change this.
VITE_API_BASE_URL=/api
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Production default: do not create the demo admin account.
CREATE_DEMO_USER=false
DEMO_USERNAME=admin
DEMO_EMAIL=admin@example.com
DEMO_PASSWORD=admin123

# Safer default for deployment. Enable only for trusted private environments.
CODE_EXECUTION_ENABLED=false
MAX_CODE_EXECUTION_TIMEOUT=10
INSTALL_CODE_RUNNERS=false

# NPM registry used while building the frontend image. If npmjs is slow, use:
# NPM_REGISTRY=https://registry.npmmirror.com/
NPM_REGISTRY=https://registry.npmjs.org/
